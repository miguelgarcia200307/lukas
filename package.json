{
  "name": "lukas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Lukas — finanzas personales voice-first (PWA). Solo herramientas locales; el frontend no tiene build.",
  "scripts": {
    "dev": "npx --yes serve -l 5173 .",
    "icons": "node scripts/generate-icons.mjs",
    "user": "node scripts/create-user.mjs",
    "deploy": "node scripts/deploy.mjs",
    "test": "node --test scripts/ai-eval/normalize.test.mjs",
    "eval": "node --use-system-ca scripts/ai-eval/run.mjs",
    "eval:whisper": "node --use-system-ca scripts/ai-eval/whisper.mjs",
    "verify": "node --use-system-ca scripts/verify.mjs"
  },
  "devDependencies": {
    "sharp": "^0.34.4"
  }
}
