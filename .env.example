# Lukas · plantilla de variables. Copia este archivo a .env.local y llena los valores reales.
# .env.local NUNCA se sube al repositorio.

# Proyecto de Supabase (Settings → API)
SUPABASE_PROJECT_REF=tu-project-ref
SUPABASE_URL=https://tu-project-ref.supabase.co
SUPABASE_ANON_KEY=pega-aqui-la-publishable-key
# SECRETA: solo scripts locales y Edge Functions
SUPABASE_SERVICE_ROLE_KEY=pega-aqui-la-secret-key-de-supabase
# Token personal de la cuenta dueña del proyecto: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=pega-aqui-tu-token-personal-de-supabase
# Opcional: la CLI usa un rol temporal si se deja vacío
SUPABASE_DB_PASSWORD=

# Groq (SECRETA: solo se carga como secret de Supabase)
GROQ_API_KEY=pega-aqui-tu-api-key-de-groq
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_CHAT_FALLBACK=openai/gpt-oss-20b

# Web Push (genera con: npx web-push generate-vapid-keys). La pública también va en js/config.js.
VAPID_PUBLIC_KEY=pega-aqui-la-llave-publica-vapid
VAPID_PRIVATE_KEY=pega-aqui-la-llave-privada-vapid
VAPID_SUBJECT=mailto:dazamiguel95@gmail.com

# Secreto compartido entre pg_cron/pg_net (Vault) y las Edge Functions internas (genera uno aleatorio largo)
CRON_SECRET=cambia-esto-por-un-valor-aleatorio-de-64-caracteres

# Orígenes extra permitidos por CORS (opcional, separados por comas)
ALLOWED_ORIGINS=

# Usuario único de la app (lo crea scripts/create-user.mjs)
USER_EMAIL=tu@correo.com
USER_PASSWORD=una-contraseña-segura
USER_NAME=Tu nombre
